DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Optional fallback for temporary testing only. Prefer DROPBOX_REFRESH_TOKEN.
DROPBOX_ACCESS_TOKEN=

DROPBOX_AUTO_JSON_PATH=/Products/auto.json
DROPBOX_MAX_PSD_MB=500
STEP1_LOG_PATH=step1-log.json

# Optional. Defaults keep output portable in the current working directory.
DROPBOX_BATCH_ROOT=.
DROPBOX_PRODUCTS_ROOT=/Pixelbuddha/Products

# Optional for Dropbox Business/team-space setups.
DROPBOX_SELECT_USER=
DROPBOX_PATH_ROOT_NAMESPACE_ID=

# Optional for shared-link generation, when upload/share steps are in scope.
DROPBOX_SHARED_LINK_VISIBILITY=
